trokeColor=#d79b00;fontColor=#7f4e00;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1180" y="513" width="515" height="356" as="geometry"/></mxCell><mxCell id="erd-teacher-relation-0" value="applicationId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;dashed=0;strokeColor=#d79b00;fontColor=#7f4e00;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="erd-teacher-table-TeacherEntranceQuestionInstance" target="erd-teacher-table-TeacherApplication"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd-teacher-relation-1" value="applicationId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;dashed=0;strokeColor=#d79b00;fontColor=#7f4e00;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="erd-teacher-table-TeacherCertificate" target="erd-teacher-table-TeacherApplication"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd-teacher-relation-2" value="applicationId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;dashed=0;strokeColor=#d79b00;fontColor=#7f4e00;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="erd-teacher-table-TeacherApplicationLog" target="erd-teacher-table-TeacherApplication"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd-teacher-relation-3" value="applicationId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;dashed=0;strokeColor=#d79b00;fontColor=#7f4e00;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="erd-teacher-table-AntiCheatLog" target="erd-teacher-table-TeacherApplication"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd-teacher-relation-4" value="applicationId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;dashed=0;strokeColor=#d79b00;fontColor=#7f4e00;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="erd-teacher-table-SuspiciousEvent" target="erd-teacher-table-TeacherApplication"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd-teacher-external" value="&lt;b&gt;Quan hệ khóa ngoại sang miền nghiệp vụ khác&lt;/b&gt;&lt;br/&gt;TeacherApplication.userId → User.id&lt;br/&gt;TeacherApplication.languageId → LearningLanguage.id&lt;br/&gt;TeacherApplication.entranceTestId → Test.id&lt;br/&gt;TeacherApplication.reviewedById → User.id&lt;br/&gt;AntiCheatLog.testAttemptId → TestAttempt.id" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7d6;strokeColor=#d6b656;fontColor=#604c00;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="2212" width="1600" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="erd-commerce" name="05 - Thanh toán, hoàn tiền và doanh thu"><mxGraphModel dx="1780" dy="3172" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="3172" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="erd-commerce-title" value="&lt;b&gt;SƠ ĐỒ QUAN HỆ — Thanh toán, hoàn tiền và doanh thu&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1680" height="50" as="geometry"/></mxCell><mxCell id="erd-commerce-legend" value="&lt;b&gt;Chú thích:&lt;/b&gt; [PK] khóa chính · [FK] khóa ngoại · [UQ] giá trị duy nhất · nét đứt = quan hệ cho phép rỗng · các trường quan hệ ảo của Prisma không phải cột cơ sở dữ liệu nên không hiển thị." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="82" width="1600" height="32" as="geometry"/></mxCell><mxCell id="erd-commerce-table-Wallet" value="&lt;b&gt;Wallet — Ví tiền&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK,UQ]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;balance: Int = 0&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số dư ví&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;updatedAt: DateTime · tự động cập nhật&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm cập nhật&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7d2623;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="515" height="236" as="geometry"/></mxCell><mxCell id="erd-commerce-table-Payment" value="&lt;b&gt;Payment — Thanh toán&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK,UQ]&lt;/b&gt; orderId: String? → Order.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã đơn hàng&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; courseId: String? → Course.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã khóa học&lt;/font&gt;&lt;br/&gt;purpose: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mục đích thanh toán&lt;/font&gt;&lt;br/&gt;pointAmount: Int?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số điểm AI&lt;/font&gt;&lt;br/&gt;provider: String = &quot;VNPAY&quot;&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Nhà cung cấp thanh toán&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[UQ]&lt;/b&gt; txnRef: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã tham chiếu giao dịch&lt;/font&gt;&lt;br/&gt;amount: Int&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số lượng / số tiền&lt;/font&gt;&lt;br/&gt;status: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái&lt;/font&gt;&lt;br/&gt;orderInfo: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thông tin đơn hàng&lt;/font&gt;&lt;br/&gt;bankCode: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã ngân hàng&lt;/font&gt;&lt;br/&gt;transactionNo: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số giao dịch&lt;/font&gt;&lt;br/&gt;responseCode: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã phản hồi&lt;/font&gt;&lt;br/&gt;transactionStatus: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái giao dịch&lt;/font&gt;&lt;br/&gt;payDate: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Ngày thanh toán&lt;/font&gt;&lt;br/&gt;rawResponse: Json?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Phản hồi gốc&lt;/font&gt;&lt;br/&gt;expiresAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm hết hạn&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;updatedAt: DateTime · tự động cập nhật&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm cập nhật&lt;/font&gt;&lt;br/&gt;──────────────&lt;br/&gt;@@index([userId, createdAt]) · Chỉ mục&lt;br/&gt;@@index([courseId, createdAt]) · Chỉ mục&lt;br/&gt;@@index([purpose, createdAt]) · Chỉ mục&lt;br/&gt;@@index([status, createdAt]) · Chỉ mục" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7d2623;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="515" height="818" as="geometry"/></mxCell><mxCell id="erd-commerce-table-Order" value="&lt;b&gt;Order — Đơn hàng&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7d2623;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="515" height="168" as="geometry"/></mxCell><mxCell id="erd-commerce-table-OrderItem" value="&lt;b&gt;OrderItem — Chi tiết đơn hàng&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; orderId: String → Order.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã đơn hàng&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; courseId: String → Course.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã khóa học&lt;/font&gt;&lt;br/&gt;price: Float&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Giá&lt;/font&gt;&lt;br/&gt;adminRevenue: Int = 0&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Doanh thu quản trị viên&lt;/font&gt;&lt;br/&gt;teacherRevenue: Int = 0&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Doanh thu giảng viên&lt;/font&gt;&lt;br/&gt;revenueSplit: String = &quot;ADMIN_ONLY&quot;&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tỷ lệ chia doanh thu&lt;/font&gt;&lt;br/&gt;──────────────&lt;br/&gt;@@unique([orderId, courseId]) · Ràng buộc duy nhất" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7d2623;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="411" width="515" height="322" as="geometry"/></mxCell><mxCell id="erd-commerce-table-CourseRefundRequest" value="&lt;b&gt;CourseRefundRequest — Yêu cầu hoàn tiền khóa học&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; studentId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã học viên&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; courseId: String → Course.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã khóa học&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK,UQ]&lt;/b&gt; orderItemId: String → OrderItem.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã chi tiết đơn hàng&lt;/font&gt;&lt;br/&gt;amount: Int&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số lượng / số tiền&lt;/font&gt;&lt;br/&gt;reason: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Lý do&lt;/font&gt;&lt;br/&gt;status: CourseRefundRequestStatus «kiểu liệt kê» = PENDING&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái&lt;/font&gt;&lt;br/&gt;adminNote: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Ghi chú quản trị viên&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; reviewedById: String? → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người xét duyệt&lt;/font&gt;&lt;br/&gt;processedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm xử lý&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;updatedAt: DateTime · tự động cập nhật&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm cập nhật&lt;/font&gt;&lt;br/&gt;refundMethod: String = &quot;EXTERNAL_ACCOUNT&quot;&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Phương thức hoàn tiền&lt;/font&gt;&lt;br/&gt;──────────────&lt;br/&gt;@@index([studentId, createdAt]) · Chỉ mục&lt;br/&gt;@@index([courseId, createdAt]) · Chỉ mục&lt;br/&gt;@@index([status, createdAt]) · Chỉ mục" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7d2623;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="993" width="515" height="562" as="geometry"/></mxCell><mxCell id="erd-commerce-table-CourseReport" value="&lt;b&gt;CourseReport — Báo cáo nội dung khóa học&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; courseId: String → Course.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã khóa học&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; reporterId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người báo cáo&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; lessonId: String? → Lesson.id&lt;br/&gt;&lt;font color=&quo