64748b&quot;&gt;↳ Mã giảng viên&lt;/font&gt;&lt;br/&gt;bankName: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tên ngân hàng&lt;/font&gt;&lt;br/&gt;accountNumber: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số tài khoản&lt;/font&gt;&lt;br/&gt;accountName: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tên chủ tài khoản&lt;/font&gt;&lt;br/&gt;branch: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Chi nhánh&lt;/font&gt;&lt;br/&gt;verificationStatus: TeacherBankAccountVerificationStatus «kiểu liệt kê» = UNVERIFIED&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái xác minh&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;updatedAt: DateTime · tự động cập nhật&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm cập nhật&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7d2623;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="788" width="515" height="372" as="geometry"/></mxCell><mxCell id="erd-commerce-table-TeacherBankAccountChangeOtp" value="&lt;b&gt;TeacherBankAccountChangeOtp — OTP đổi tài khoản ngân hàng&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; teacherId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã giảng viên&lt;/font&gt;&lt;br/&gt;email: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Địa chỉ thư điện tử&lt;/font&gt;&lt;br/&gt;codeHash: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã băm OTP&lt;/font&gt;&lt;br/&gt;payload: Json&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Dữ liệu yêu cầu&lt;/font&gt;&lt;br/&gt;expiresAt: DateTime&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm hết hạn&lt;/font&gt;&lt;br/&gt;consumedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm đã sử dụng&lt;/font&gt;&lt;br/&gt;attempts: Int = 0&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số lần thử&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;updatedAt: DateTime · tự động cập nhật&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm cập nhật&lt;/font&gt;&lt;br/&gt;──────────────&lt;br/&gt;@@index([teacherId, createdAt]) · Chỉ mục&lt;br/&gt;@@index([email, createdAt]) · Chỉ mục" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7d2623;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="1610" width="515" height="442" as="geometry"/></mxCell><mxCell id="erd-commerce-table-TeacherBankAccountChangeLog" value="&lt;b&gt;TeacherBankAccountChangeLog — Nhật ký đổi tài khoản ngân hàng&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; teacherId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã giảng viên&lt;/font&gt;&lt;br/&gt;previousBankName: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tên ngân hàng trước&lt;/font&gt;&lt;br/&gt;previousAccountNumberMasked: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số tài khoản trước đã che&lt;/font&gt;&lt;br/&gt;previousAccountName: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tên chủ tài khoản trước&lt;/font&gt;&lt;br/&gt;previousBranch: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Chi nhánh trước&lt;/font&gt;&lt;br/&gt;nextBankName: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tên ngân hàng mới&lt;/font&gt;&lt;br/&gt;nextAccountNumberMasked: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số t