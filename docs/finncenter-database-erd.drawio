xGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd-commerce-relation-1" value="orderId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;dashed=0;strokeColor=#b85450;fontColor=#7d2623;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="erd-commerce-table-OrderItem" target="erd-commerce-table-Order"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd-commerce-relation-2" value="orderItemId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;dashed=0;strokeColor=#b85450;fontColor=#7d2623;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="erd-commerce-table-CourseRefundRequest" target="erd-commerce-table-OrderItem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd-commerce-relation-3" value="withdrawalId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;dashed=0;strokeColor=#b85450;fontColor=#7d2623;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="erd-commerce-table-TeacherRevenueWithdrawalComplaint" target="erd-commerce-table-TeacherRevenueWithdrawal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd-commerce-external" value="&lt;b&gt;Quan hệ khóa ngoại sang miền nghiệp vụ khác&lt;/b&gt;&lt;br/&gt;Wallet.userId → User.id&lt;br/&gt;Payment.userId → User.id&lt;br/&gt;Payment.courseId → Course.id&lt;br/&gt;Order.userId → User.id&lt;br/&gt;OrderItem.courseId → Course.id&lt;br/&gt;CourseRefundRequest.studentId → User.id&lt;br/&gt;CourseRefundRequest.courseId → Course.id&lt;br/&gt;CourseRefundRequest.reviewedById → User.id&lt;br/&gt;CourseReport.courseId → Course.id&lt;br/&gt;CourseReport.reporterId → User.id&lt;br/&gt;CourseRepo