completedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm hoàn thành&lt;/font&gt;&lt;br/&gt;seekViolation: Boolean = false&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Vi phạm tua video&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;updatedAt: DateTime · tự động cập nhật&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm cập nhật&lt;/font&gt;&lt;br/&gt;──────────────&lt;br/&gt;@@unique([userId, lessonId]) · Ràng buộc duy nhất&lt;br/&gt;@@index([lessonId, updatedAt]) · Chỉ mục" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#274e13;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="751" width="515" height="476" as="geometry"/></mxCell><mxCell id="erd-learning-table-Enrollment" value="&lt;b&gt;Enrollment — Ghi danh khóa học&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; courseId: String → Course.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã khóa học&lt;/font&gt;&lt;br/&gt;accessStatus: EnrollmentAccessStatus «kiểu liệt kê» = ACTIVE&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái quyền truy cập&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;──────────────&lt;br/&gt;@@unique([userId, courseId]) · Ràng buộc duy nhất" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#274e13;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="377" width="515" height="254" as="geometry"/></mxCell><mxCell id="erd-learning-table-Feedback" value="&lt;b&gt;Feedback — Phản hồi khóa học và tiến độ&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; courseId: String → Course.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã khóa học&lt;/font&gt;&lt;br/&gt;content: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Nội dung&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#274e13;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1180" y="411" width="515" height="236" as="geometry"/></mxCell><mxCell id="erd-learning-table-LearningActivity" value="&lt;b&gt;LearningActivity — Hoạt động học tập&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; courseId: String? → Course.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã khóa học&lt;/font&gt;&lt;br/&gt;activityType: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Loại hoạt động&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[UQ]&lt;/b&gt; sourceKey: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Khóa nguồn chống trùng&lt;/font&gt;&lt;br/&gt;activityDate: DateTime&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Ngày hoạt động&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&