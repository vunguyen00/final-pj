<diagram id="erd-auth" name="01 - Tài khoản, bảo mật và ngôn ngữ"><mxGraphModel dx="1780" dy="1410" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1410" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="erd-auth-title" value="&lt;b&gt;SƠ ĐỒ QUAN HỆ — Tài khoản, bảo mật và ngôn ngữ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1680" height="50" as="geometry"/></mxCell><mxCell id="erd-auth-legend" value="&lt;b&gt;Chú thích:&lt;/b&gt; [PK] khóa chính · [FK] khóa ngoại · [UQ] giá trị duy nhất · nét đứt = quan hệ cho phép rỗng · các trường quan hệ ảo của Prisma không phải cột cơ sở dữ liệu nên không hiển thị." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="82" width="1600" height="32" as="geometry"/></mxCell><mxCell id="erd-auth-table-User" value="&lt;b&gt;User — Người dùng&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;username: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tên hiển thị&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[UQ]&lt;/b&gt; email: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Địa chỉ thư điện tử&lt;/font&gt;&lt;br/&gt;password: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mật khẩu đã băm&lt;/font&gt;&lt;br/&gt;role: Role «kiểu liệt kê» = STUDENT&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Vai trò&lt;/font&gt;&lt;br/&gt;phoneNumber: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số điện thoại&lt;/font&gt;&lt;br/&gt;isBanned: Boolean = false&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Đang bị khóa&lt;/font&gt;&lt;br/&gt;accountStatus: UserAccountStatus «kiểu liệt kê» = ACTIVE&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái tài khoản&lt;/font&gt;&lt;br/&gt;emailVerifiedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm xác thực thư điện tử&lt;/font&gt;&lt;br/&gt;authVersion: Int = 0&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Phiên bản xác thực&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; learningLanguageId: String? → LearningLanguage.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã ngôn ngữ học&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3b5b;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="515" height="474" as="geometry"/></mxCell><mxCell id="erd-auth-table-Session" value="&lt;b&gt;Session — Phiên đăng nhập&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[UQ]&lt;/b&gt; tokenHash: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã băm của token&lt;/font&gt;&lt;br/&gt;expiresAt: DateTime&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm hết hạn&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3b5b;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="515" height="236" as="geometry"/></mxCell><mxCell id="erd-auth-table-PasswordResetOtp" value="&lt;b&gt;PasswordResetOtp — Mã OTP đặt lại mật khẩu&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;email: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Địa chỉ thư điện tử&lt;/font&gt;&lt;br/&gt;codeHash: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã băm OTP&lt;/font&gt;&lt;br/&gt;expiresAt: DateTime&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm hết hạn&lt;/font&gt;&lt;br/&gt;consumedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm đã sử dụng&lt;/font&gt;&lt;br/&gt;attempts: Int&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số lần thử&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;──────────────&lt;br/&gt;@@index([userId, createdAt]) · Chỉ mục&lt;br/&gt;@@index([email, createdAt]) · Chỉ mục" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3b5b;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="515" height="374" as="geometry"/></mxCell><mxCell id="erd-auth-table-EmailVerificationOtp" value="&lt;b&gt;EmailVerificationOtp — Mã OTP xác thực thư điện tử&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;email: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Địa chỉ thư điện tử&lt;/font&gt;&lt;br/&gt;codeHash: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã băm OTP&lt;/font&gt;&lt;br/&gt;expiresAt: DateTime&