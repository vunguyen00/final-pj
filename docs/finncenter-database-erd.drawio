<diagram id="erd-communication" name="06 - Thông báo và thư điện tử"><mxGraphModel dx="1780" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="erd-communication-title" value="&lt;b&gt;SƠ ĐỒ QUAN HỆ — Thông báo và thư điện tử&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e8088;strokeColor=#0e8088;fontColor=#ffffff;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1680" height="50" as="geometry"/></mxCell><mxCell id="erd-communication-legend" value="&lt;b&gt;Chú thích:&lt;/b&gt; [PK] khóa chính · [FK] khóa ngoại · [UQ] giá trị duy nhất · nét đứt = quan hệ cho phép rỗng · các trường quan hệ ảo của Prisma không phải cột cơ sở dữ liệu nên không hiển thị." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="82" width="1600" height="32" as="geometry"/></mxCell><mxCell id="erd-communication-table-Notification" value="&lt;b&gt;Notification — Thông báo&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;title: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tiêu đề&lt;/font&gt;&lt;br/&gt;body: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Nội dung&lt;/font&gt;&lt;br/&gt;readAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm đã đọc&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8e6;strokeColor=#0e8088;fontColor=#0b555b;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="700" height="270" as="geometry"/></mxCell><mxCell id="erd-communication-table-EmailLog" value="&lt;b&gt;EmailLog — Nhật ký thư điện tử&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String? → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;to: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Địa chỉ nhận&lt;/font&gt;&lt;br/&gt;subject: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tiêu đề thư&lt;/font&gt;&lt;br/&gt;status: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái&lt;/font&gt;&lt;br/&gt;error: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Lỗi&lt;/font&gt;&lt;br/&gt;sentAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm gửi&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8e6;strokeColor=#0e8088;fontColor=#0b555b;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="805" y="120" width="700" height="338" as="geometry"/></mxCell><mxCell id="erd-communication-external" value="&lt;b&gt;Quan hệ khóa ngoại sang miền nghiệp vụ khác&lt;/b&gt;&lt;br/&gt;Notification.userId → User.id&lt;br/&gt;EmailLog.userId → User.id" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7d6;strokeColor=#d6b656;fontColor=#604c00;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="553" width="1600" height="79" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="erd-enums" name="07 - Danh mục kiểu liệt kê"><mxGraphModel dx="1780" dy="1243" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1243" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="erd-enum-title" value="&lt;b&gt;DANH MỤC KIỂU LIỆT KÊ PRISMA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#334155;fontColor=#ffffff;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1680" height="50" as="geometry"/></mxCell><mxCell id="erd-enum-Role" value="&lt;b&gt;«kiểu liệt kê» Role&lt;/b&gt;&lt;br/&gt;Vai trò người dùng&lt;br/&gt;────────────&lt;br/&gt;STUDENT&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Học viên&lt;/font&gt;&lt;br/&gt;TEACHER&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Giảng viên&lt;/font&gt;&lt;br/&gt;ADMIN&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Quản trị viên&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="380" height="162" as="geometry"/></mxCell><mxCell id="erd-enum-UserAccountStatus" value="&lt;b&gt;«kiểu liệt kê» UserAccountStatus&lt;/b&gt;&lt;br/&gt;Trạng thái tài khoản&lt;br/&gt;────────────&lt;br/&gt;PENDING_VERIFICATION&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Chờ xác thực&lt;/font&gt;&lt;br/&gt;ACTIVE&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Đang hoạt động&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="380" height="126" as="geometry"/></mxCell><mxCell id="erd-enum-CourseStatus" value="&lt;b&gt;«kiểu liệt kê» CourseStatus&lt;/b&gt;&lt;br/&gt;Trạng thái khóa học&lt;br/&gt;