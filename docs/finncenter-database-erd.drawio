<diagram id="erd-learning" name="02 - Khóa học và tiến độ học tập"><mxGraphModel dx="1780" dy="1939" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1939" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="erd-learning-title" value="&lt;b&gt;SƠ ĐỒ QUAN HỆ — Khóa học và tiến độ học tập&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1680" height="50" as="geometry"/></mxCell><mxCell id="erd-learning-legend" value="&lt;b&gt;Chú thích:&lt;/b&gt; [PK] khóa chính · [FK] khóa ngoại · [UQ] giá trị duy nhất · nét đứt = quan hệ cho phép rỗng · các trường quan hệ ảo của Prisma không phải cột cơ sở dữ liệu nên không hiển thị." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="82" width="1600" height="32" as="geometry"/></mxCell><mxCell id="erd-learning-table-Course" value="&lt;b&gt;Course — Khóa học&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;name: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tên&lt;/font&gt;&lt;br/&gt;description: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mô tả&lt;/font&gt;&lt;br/&gt;thumbnail: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Ảnh đại diện&lt;/font&gt;&lt;br/&gt;category: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Danh mục&lt;/font&gt;&lt;br/&gt;level: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trình độ&lt;/font&gt;&lt;br/&gt;duration: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời lượng&lt;/font&gt;&lt;br/&gt;lessons: Int = 0&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số bài học&lt;/font&gt;&lt;br/&gt;status: CourseStatus «kiểu liệt kê» = ACTIVE&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái&lt;/font&gt;&lt;br/&gt;deleteRequestedFromStatus: CourseStatus? «kiểu liệt kê»&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái trước khi yêu cầu xóa&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;updatedAt: DateTime · tự động cập nhật&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm cập nhật&lt;/font&gt;&lt;br/&gt;price: Float&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Giá&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; languageId: String? → LearningLanguage.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã ngôn ngữ&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; instructorId: String? → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã giảng viên&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#274e13;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="515" height="576" as="geometry"/></mxCell><mxCell id="erd-learning-table-Module" value="&lt;b&gt;Module — Chương học&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; courseId: String → Course.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã khóa học&lt;/font&gt;&lt;br/&gt;name: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tên&lt;/font&gt;&lt;br/&gt;order: Int&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thứ tự&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#274e13;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="515" height="202" as="geometry"/