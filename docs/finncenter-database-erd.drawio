<diagram id="erd-teacher" name="04 - Đăng ký giảng viên và chống gian lận"><mxGraphModel dx="1780" dy="2417" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="2417" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="erd-teacher-title" value="&lt;b&gt;SƠ ĐỒ QUAN HỆ — Đăng ký giảng viên và chống gian lận&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#d79b00;fontColor=#ffffff;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1680" height="50" as="geometry"/></mxCell><mxCell id="erd-teacher-legend" value="&lt;b&gt;Chú thích:&lt;/b&gt; [PK] khóa chính · [FK] khóa ngoại · [UQ] giá trị duy nhất · nét đứt = quan hệ cho phép rỗng · các trường quan hệ ảo của Prisma không phải cột cơ sở dữ liệu nên không hiển thị." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="82" width="1600" height="32" as="geometry"/></mxCell><mxCell id="erd-teacher-table-TeacherApplication" value="&lt;b&gt;TeacherApplication — Hồ sơ đăng ký giảng viên&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; userId: String → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người dùng&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; languageId: String → LearningLanguage.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã ngôn ngữ&lt;/font&gt;&lt;br/&gt;status: TeacherApplicationStatus «kiểu liệt kê» = DRAFT&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái&lt;/font&gt;&lt;br/&gt;attemptNo: Int&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số thứ tự lượt làm&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; entranceTestId: String? → Test.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã bài thi đầu vào&lt;/font&gt;&lt;br/&gt;entranceAttemptId: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã lượt thi đầu vào&lt;/font&gt;&lt;br/&gt;answerState: Json?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái câu trả lời&lt;/font&gt;&lt;br/&gt;startedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm bắt đầu&lt;/font&gt;&lt;br/&gt;submittedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm nộp&lt;/font&gt;&lt;br/&gt;reviewedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm xét duyệt&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; reviewedById: String? → User.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người xét duyệt&lt;/font&gt;&lt;br/&gt;rejectionReason: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Lý do từ chối&lt;/font&gt;&lt;br/&gt;violationCount: Int = 0&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số lần vi phạm&lt;/font&gt;&lt;br/&gt;failureReason: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Lý do thất bại&lt;/font&gt;&lt;br/&gt;antiCheatAcknowledgedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm xác nhận chống gian lận&lt;/font&gt;&lt;br/&gt;proctorSessionId: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã phiên giám sát&lt;/font&gt;&lt;br/&gt;proctorHeartbeatAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm nhịp giám sát&lt;/font&gt;&lt;br/&gt;proctorHeartbeatSequence: Int = 0&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số thứ tự nhịp giám sát&lt;/font&gt;&lt;br/&gt;questionRevealState: Json?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái mở câu hỏi&lt;/font&gt;&lt;br/&gt;currentQuestionInstanceId: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã câu hỏi hiện tại&lt;/font&gt;&lt;br/&gt;sequentialCompletedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm hoàn tất tuần tự&lt;/font&gt;&lt;br/&gt;entrancePassingScore: Float?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Điểm đạt đầu vào&lt;/font&gt;&lt;br/&gt;entranceMaxScore: Float?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Điểm tối đa đầu vào&lt;/font&gt;&lt;br/&gt;entranceTimeLimit: Int?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Giới hạn thời gian đầu vào&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;updatedAt: DateTime · tự động cập nhật&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm cập nhật&lt;/font&gt;&lt;br/&gt;──────────────&lt;br/&gt;@@index([userId, createdAt]) · Chỉ mục&lt;br/&gt;@@index([status, createdAt]) · Chỉ mục" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7f4e00;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="515" height="1020" as="geometry"/></mxCell><mxCell id="erd-teacher-table-TeacherEntranceQuestionInstance" value="&lt;b&gt;TeacherEntranceQuestionInstance — Câu hỏi thi đầu vào giảng viên&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; applicationId: String → TeacherApplication.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã hồ sơ&lt;/font&gt;&lt;br/&gt;sourceQuestionId: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã câu hỏi nguồn&lt;/font&gt;&lt;br/&gt;sequence: Int&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thứ tự câu hỏi&lt;/font&gt;&lt;br/&gt;type: QuestionType «kiểu liệt kê»&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Loại&lt;/font&gt;&lt;br/&gt;content: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Nội dung&lt;/font&gt;&lt;br/&gt;audioUrl: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Đường dẫn âm thanh&lt;/font&gt;&lt;br/&gt;hint: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Gợi ý&lt;/font&gt;&lt;br/&gt;score: Float&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Điểm&lt;/font&gt;&lt;br/&gt;preparationTimeSeconds: Int?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời gian chuẩn bị (giây)&lt;/font&gt;&lt;br/&gt;answerTimeSeconds: Int?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời gian trả lời (giây)&lt;/font&gt;&lt;br/&gt;answerOptions: Json?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Các lựa chọn trả lời&lt;/font&gt;&lt;br/&gt;scoringData: Json?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Dữ liệu chấm điểm&lt;/font&gt;&lt;br/&gt;status: TeacherQuestionInstanceStatus «kiểu liệt kê» = LOCKED&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái&lt;/font&gt;&lt;br/&gt;revealedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm mở câu hỏi&lt;/font&gt;&lt;br/&gt;answerStartsAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm bắt đầu trả lời&lt;/font&gt;&lt;br/&gt;deadlineAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Hạn trả lời&lt;/font&gt;&lt;br/&gt;answerState: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái câu trả lời&lt;/font&gt;&lt;br/&gt;answerRevision: Int = 0&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Phiên bản câu trả lời&lt;/font&gt;&lt;br/&gt;finalAnswer: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Câu trả lời cuối&lt;/font&gt;&lt;br/&gt;finalizedAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm chốt câu trả lời&lt;/font&gt;&lt;br/&gt;transitionTokenHash: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã băm token chuyển câu&lt;/font&gt;&lt;br/&gt;transitionTokenExpiresAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Hạn token chuyển câu&lt;/font&gt;&lt;br/&gt;speakingAudioUrl: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Đường dẫn âm thanh bài nói&lt;/font&gt;&lt;br/&gt;speakingAudioHash: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã băm âm thanh bài nói&lt;/font&gt;&lt;br/&gt;speakingAudioMime: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Định dạng MIME âm thanh&lt;/font&gt;&lt;br/&gt;speakingAudioBytes: Int?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Kích thước âm thanh (byte)&lt;/font&gt;&lt;br/&gt;speakingMediaStatus: TeacherSpeakingMediaStatus «kiểu liệt kê» = NONE&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái tệp bài nói&lt;/font&gt;&lt;br/&gt;speakingTranscript: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Bản chép lời bài nói&lt;/font&gt;&lt;br/&gt;speakingProcessingTokenHash: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã băm token xử lý bài nói&lt;/font&gt;&lt;br/&gt;speakingProcessingTokenExpiresAt: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Hạn token xử lý bài nói&lt;/font&gt;&lt;br/&gt;speakingProcessingError: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Lỗi xử lý bài nói&lt;/font&gt;&lt;br/&gt;speakingProcessingAttempts: Int = 0&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Số lần xử lý bài nói&lt;/font&gt;&lt;br/&gt;contentHash: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã băm nội dung&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;&lt;br/&gt;updatedAt: DateTime · tự động cập nhật&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm cập nhật&lt;/font&gt;&lt;br/&gt;──────────────&lt;br/&gt;@@unique([applicationId, sequence]) · Ràng buộc duy nhất&lt;br/&gt;@@index([applicationId, status]) · Chỉ mục&lt;br/&gt;@@index([applicationId, id]) · Chỉ mục&lt;br/&gt;@@index([applicationId, speakingMediaStatus]) · Chỉ mục" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7f4e00;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="515" height="1362" as="geometry"/></mxCell><mxCell id="erd-teacher-table-TeacherCertificate" value="&lt;b&gt;TeacherCertificate — Chứng chỉ giảng viên&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; applicationId: String → TeacherApplication.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã hồ sơ&lt;/font&gt;&lt;br/&gt;fileName: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Tên tệp&lt;/font&gt;&lt;br/&gt;fileUrl: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Đường dẫn tệp&lt;/font&gt;&lt;br/&gt;fileType: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Loại tệp&lt;/font&gt;&lt;br/&gt;fileSize: Int&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Kích thước tệp&lt;/font&gt;&lt;br/&gt;expiryDate: DateTime&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Ngày hết hạn&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7f4e00;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="515" height="338" as="geometry"/></mxCell><mxCell id="erd-teacher-table-TeacherApplicationLog" value="&lt;b&gt;TeacherApplicationLog — Nhật ký hồ sơ giảng viên&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; applicationId: String → TeacherApplication.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã hồ sơ&lt;/font&gt;&lt;br/&gt;status: TeacherApplicationStatus «kiểu liệt kê»&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Trạng thái&lt;/font&gt;&lt;br/&gt;message: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Nội dung thông báo&lt;/font&gt;&lt;br/&gt;actorId: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã người thực hiện&lt;/font&gt;&lt;br/&gt;createdAt: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm tạo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7f4e00;fontSize=11;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="1195" width="515" height="270" as="geometry"/></mxCell><mxCell id="erd-teacher-table-AntiCheatLog" value="&lt;b&gt;AntiCheatLog — Nhật ký chống gian lận&lt;/b&gt;&lt;br/&gt;──────────────&lt;br/&gt;&lt;b&gt;[PK]&lt;/b&gt; id: String = uuid()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã định danh&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; applicationId: String → TeacherApplication.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã hồ sơ&lt;/font&gt;&lt;br/&gt;&lt;b&gt;[FK]&lt;/b&gt; testAttemptId: String? → TestAttempt.id&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mã lượt làm bài&lt;/font&gt;&lt;br/&gt;eventType: String&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Loại sự kiện&lt;/font&gt;&lt;br/&gt;detail: String?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Chi tiết&lt;/font&gt;&lt;br/&gt;severity: Int = 1&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Mức độ nghiêm trọng&lt;/font&gt;&lt;br/&gt;durationSeconds: Int?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời lượng (giây)&lt;/font&gt;&lt;br/&gt;confidence: Float?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Độ tin cậy&lt;/font&gt;&lt;br/&gt;counted: Boolean = false&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Đã tính vi phạm&lt;/font&gt;&lt;br/&gt;clientTimestamp: DateTime?&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm phía máy khách&lt;/font&gt;&lt;br/&gt;serverTimestamp: DateTime = now()&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;↳ Thời điểm phía máy chủ&lt;/font&gt