<diagram id="arch-layer" name="02 - Kiến trúc phân lớp"><mxGraphModel dx="1800" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arch-layer-title" value="&lt;b&gt;CÁC LỚP CÔNG VIỆC TRONG HỆ THỐNG FINNCENTER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=16;spacing=8;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="52" as="geometry"/></mxCell><mxCell id="layer-presentation" value="&lt;b&gt;1. NHỮNG GÌ NGƯỜI DÙNG NHÌN THẤY&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Các trang, biểu mẫu, nút bấm, bảng số liệu và phần thu âm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#134e4a;fontSize=16;spacing=8;fontSize=17;align=left;verticalAlign=middle;spacingLeft=28;shadow=1;" vertex="1" parent="1"><mxGeometry x="170" y="125" width="1460" height="120" as="geometry"/></mxCell><mxCell id="layer-api" value="&lt;b&gt;2. NƠI TIẾP NHẬN YÊU CẦU&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Nhận thông tin người dùng gửi lên, kiểm tra đủ dữ liệu và chuyển đến đúng bộ phận&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=16;spacing=8;fontSize=17;align=left;verticalAlign=middle;spacingLeft=28;shadow=1;" vertex="1" parent="1"><mxGeometry x="170" y="290" width="1460" height="120" as="geometry"/></mxCell><mxCell id="layer-e-1" value="gửi thông tin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontColor=#334155;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="layer-presentation" target="layer-api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="layer-domain" value="&lt;b&gt;3. NƠI ÁP DỤNG QUY TẮC&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Kiểm tra quyền, điều kiện học, cách chấm điểm, cách chia doanh thu và xử lý rút tiền&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=16;spacing=8;fontSize=17;align=left;verticalAlign=middle;spacingLeft=28;shadow=1;" vertex="1" parent="1"><mxGeometry x="170" y="455" width="1460" height="120" as="geometry"/></mxCell><mxCell id="layer-e-2" value="yêu cầu xử lý" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontColor=#334155;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="layer-api" target="layer-domain"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="layer-data" value="&lt;b&gt;4. NƠI QUẢN LÝ HỒ SƠ&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Đọc, lưu và bảo vệ thông tin tài khoản, khóa học, kết quả, thanh toán và doanh thu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=16;spacing=8;fontSize=17;align=left;verticalAlign=middle;spacingLeft=28;shadow=1;" vertex="1" parent="1"><mxGeometry x="170" y="620" width="1460" height="120" as="geometry"/></mxCell><mxCell id="layer-e-3" value="đọc hoặc lưu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontColor=#334155;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="layer-domain" target="layer-data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="layer-infra" value="&lt;b&gt;5. CÁC ĐƠN VỊ HỖ TRỢ&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Kho dữ liệu, cổng thanh toán, trợ lý AI, email, kho tệp và đường kết nối Internet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=16;spacing=8;fontSize=17;align=left;verticalAlign=middle;spacingLeft=28;shadow=1;" vertex="1" parent="1"><mxGeometry x="170" y="785" width="1460" height="120" as="geometry"/></mxCell><mxCell id="layer-e-4" value="sử dụng dịch vụ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontColor=#334155;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="layer-data" target="layer-infra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="layer-cross" value="&lt;b&gt;NGUYÊN TẮC ÁP DỤNG Ở MỌI LỚP&lt;/b&gt;&lt;br/&gt;Đúng người, đúng quyền • thông tin hợp lệ • lưu dấu thay đổi • không ghi nhận hai lần • bảo vệ dữ liệu cá nhân" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;fontSize=16;spacing=8;fontSize=16;" vertex="1" parent="1"><mxGeometry x="250" y="960" width="1300" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="erd-overview-main" name="03 - ERD tổng quan"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="erd-title" value="&lt;b&gt;ERD TỔNG QUAN — BẢN ĐỒ NHỮNG THÔNG TIN HỆ THỐNG LƯU GIỮ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=16;spacing=8;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="52" as="geometry"/></mxCell><mxCell id="erd-note" value="Mỗi ô là một nhóm thông tin được lưu. Mũi tên cho biết các nhóm thông tin liên quan với nhau như thế nào." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;fontSize=16;spacing=8;fontSize=16;" vertex="1" parent="1"><mxGeometry x="260" y="84" width="1280" height="48" as="geometry"/></mxCell><mxCell id="erd-user" value="&lt;b&gt;Tài khoản người dùng&lt;/b&gt;&lt;hr/&gt;Mã tài khoản&lt;br/&gt;Tên và email&lt;br/&gt;Loại tài khoản&lt;br/&gt;Ngôn ngữ đang học" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-session" value="&lt;b&gt;Lần đăng nhập&lt;/b&gt;&lt;hr/&gt;Thuộc tài khoản nào&lt;br/&gt;Thiết bị đang dùng&lt;br/&gt;Thời điểm hết hạn&lt;br/&gt;Lần hoạt động gần nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-otp" value="&lt;b&gt;Mã lấy lại mật khẩu&lt;/b&gt;&lt;hr/&gt;Thuộc tài khoản nào&lt;br/&gt;Mã xác nhận đã bảo vệ&lt;br/&gt;Thời điểm hết hạn&lt;br/&gt;Số lần nhập sai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-language" value="&lt;b&gt;Ngôn ngữ học&lt;/b&gt;&lt;hr/&gt;Tên ngôn ngữ&lt;br/&gt;Mã viết tắt&lt;br/&gt;Còn được sử dụng không" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#134e4a;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-course" value="&lt;b&gt;Khóa học&lt;/b&gt;&lt;hr/&gt;Tên và mô tả&lt;br/&gt;Giáo viên phụ trách&lt;br/&gt;Ngôn ngữ&lt;br/&gt;Giá và tình trạng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-module" value="&lt;b&gt;Chương học&lt;/b&gt;&lt;hr/&gt;Thuộc khóa học nào&lt;br/&gt;Tên chương&lt;br/&gt;Thứ tự học" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="350" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-lesson" value="&lt;b&gt;Bài học&lt;/b&gt;&lt;hr/&gt;Thuộc chương nào&lt;br/&gt;Tên và nội dung&lt;br/&gt;Video nếu có" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="530" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-enroll" value="&lt;b&gt;Ghi danh&lt;/b&gt;&lt;hr/&gt;Người học&lt;br/&gt;Khóa đã đăng ký&lt;br/&gt;Quyền học hiện tại&lt;br/&gt;Ngày đăng ký" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="710" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-test" value="&lt;b&gt;Bài kiểm tra&lt;/b&gt;&lt;hr/&gt;Thuộc khóa/chương/bài&lt;br/&gt;Loại bài kiểm tra&lt;br/&gt;Điểm đạt&lt;br/&gt;Thời gian và số lần làm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-question" value="&lt;b&gt;Câu hỏi&lt;/b&gt;&lt;hr/&gt;Thuộc bài kiểm tra&lt;br/&gt;Nội dung và loại câu&lt;br/&gt;Số điểm&lt;br/&gt;Thứ tự" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-answer" value="&lt;b&gt;Đáp án&lt;/b&gt;&lt;hr/&gt;Thuộc câu hỏi&lt;br/&gt;Nội dung đáp án&lt;br/&gt;Đúng hay sai&lt;br/&gt;Lời giải thích" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=16;spacing=8;align=left;verticalAlign=top;fontSize=16;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="700" y="530" width="260" height="145" as="geometry"/></mxCell><mxCell id="erd-attempt" value="&lt;b&gt;Lần làm bài&lt;/b&gt;&lt;hr/&gt;Người làm và bài kiểm tra&lt;br/&gt;Lần làm thứ mấy&lt;br/&gt;Điểm đạt được&lt;br/&gt;Đạt hay c