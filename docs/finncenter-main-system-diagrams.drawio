"1" parent="1"><mxGeometry x="140" y="1207" width="1" height="1" as="geometry"/></mxCell><mxCell id="seq-08-m-21" value="&lt;b&gt;22.&lt;/b&gt; Báo kết quả xử lý yêu cầu rút" style="endArrow=open;endFill=0;dashed=1;dashPattern=4 4;strokeColor=#475569;fontColor=#1e3a8a;fontSize=16;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="seq-08-m-21-a" target="seq-08-m-21-b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="seq-08-note" value="&lt;b&gt;Điều cần lưu ý:&lt;/b&gt; FinnCenter không kết nối trực tiếp với ngân hàng và không tự chuyển tiền. Quản trị viên chuyển khoản ở bên ngoài, sau đó chỉ ghi nhận kết quả trên hệ thống." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=16;spacing=8;shape=note;fontSize=16;" vertex="1" parent="1"><mxGeometry x="170" y="1344" width="1860" height="85" as="geometry"/></mxCell></root></mxGraphModel></diagram>
