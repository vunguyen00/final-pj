generator client {
  provider = "prisma-client"
  output   = "../.generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                              @id @default(uuid())
  username                     String
  email                        String                              @unique
  password                     String
  role                         Role                                @default(STUDENT)
  phoneNumber                  String?
  isBanned                     Boolean                             @default(false)
  accountStatus                UserAccountStatus                   @default(ACTIVE)
  emailVerifiedAt              DateTime?
  authVersion                  Int                                 @default(0)
  learningLanguageId           String?
  createdAt                    DateTime                            @default(now())
  sessions                     Session[]
  passwordResetOtps            PasswordResetOtp[]
  emailVerificationOtps        EmailVerificationOtp[]
  registrationSecurityEvents   RegistrationSecurityEvent[]
  enrollments                  Enrollment[]
  testAttempts                 TestAttempt[]
  feedbacks                    Feedback[]
  orders                       Order[]
  payments                     Payment[]
  wallet                       Wallet?
  courses                      Course[]
  refundRequests               CourseRefundRequest[]               @relation("RefundRequestStudent")
  reviewedRefundRequests       CourseRefundRequest[]               @relation("RefundRequestReviewer")
  courseReports                CourseReport[]                      @relation("CourseReportReporter")
  respondedCourseReports       CourseReport[]                      @relation("CourseReportResponder")
  aiAssessments                AiAssessment[]
  pointTransactions            PointTransaction[]
  learningActivities           LearningActivity[]
  learningLanguage             LearningLanguage?                   @relation("UserLearningLanguage", fields: [learningLanguageId], references: [id])
  teacherApplications          TeacherApplication[]                @relation("TeacherApplicationUser")
  reviewedTeacherApplications  TeacherApplication[]                @relation("TeacherApplicationReviewer")
  notifications                Notification[]
  emailLogs                    EmailLog[]
  teacherBankAccount           TeacherBankAccount?
  teacherBankAccountChangeOtps TeacherBankAccountChangeOtp[]
  teacherBankAccountChangeLogs TeacherBankAccountChangeLog[]
  revenueWithdrawals           TeacherRevenueWithdrawal[]
  revenueWithdrawalComplaints  TeacherRevenueWithdrawalComplaint[]
  processedRevenueWithdrawals  TeacherRevenueWithdrawal[]          @relation("RevenueWithdrawalProcessor")
  videoWatchProgress           VideoWatchProgress[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserAccountStatus {
  PENDING_VERIFICATION
  ACTIVE
}

model EmailVerificationOtp {
  id                String    @id @default(uuid())
  userId            String
  email             String
  codeHash          String
  expiresAt         DateTime
  consumedAt        DateTime?
  attempts          Int       @default(0)
  resendAvailableAt DateTime
  requestIp         String?
  deviceFingerprint String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([requestIp, createdAt])
  @@index([deviceFingerprint, createdAt])
}

model RegistrationSecurityEvent {
  id                String   @id @default(uuid())
  userId            String?
  email             String
  requestIp         String?
  deviceFingerprint String?
  eventType         String
  detail            Json?
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([requestIp, createdAt])
  @@index([eventType, createdAt])
}

model Course {
  id                        String        @id @default(uuid())
  name                      String
  description               String
  thumbnail                 String?
  category                  String?
  level                     String?
  duration                  String?
  lessons                   Int           @default(0)
  status                    CourseStatus  @default(ACTIVE)
  deleteRequestedFromStatus CourseStatus?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  price                     Float
  languageId                String?
  instructorId              String? // ID của giảng viên

  instructor         User?                 @relation(fields: [instructorId], references: [id])
  language           LearningLanguage?     @relation(fields: [languageId], references: [id])
  modules            Module[]
  enrollments        Enrollment[]
  tests              Test[]
  feedbacks          Feedback[]
  orderItems         OrderItem[]
  refundRequests     CourseRefundRequest[]
  aiAssessments      AiAssessment[]
  pointTransactions  PointTransaction[]
  learningActivities LearningActivity[]
  payments           Payment[]
  reports            CourseReport[]
}

enum CourseStatus {
  ACTIVE
  LOCKED
  PENDING_APPROVAL
  PENDING_DELETE
  REJECTED
}

model Module {
  id       String @id @default(uuid())
  courseId String
  name     String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id])
  lessons Lesson[]
  tests   Test[]
}

model Lesson {
  id       String  @id @default(uuid())
  moduleId String
  title    String
  content  String
  videoUrl String?

  module        Module               @relation(fields: [moduleId], references: [id])
  watchProgress VideoWatchProgress[]
  reports       CourseReport[]
  tests         Test[]
}

model VideoWatchProgress {
  id                  String    @id @default(uuid())
  userId              String
  lessonId            String
  lastPositionSeconds Float     @default(0)
  durationSeconds     Float?
  lastHeartbeatAt     DateTime  @default(now())
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  seekViolation       Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId, updatedAt])
}

enum EnrollmentAccessStatus {
  ACTIVE
  REFUND_PENDING
}

model Enrollment {
  id           String                 @id @default(uuid())
  userId       String
  courseId     String
  accessStatus EnrollmentAccessStatus @default(ACTIVE)
  createdAt    DateTime               @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Test {
  id               String             @id @default(uuid())
  courseId         String?
  languageId       String?
  moduleId         String?
  lessonId         String?
  kind             TestKind           @default(COURSE)
  assessmentMode   TestAssessmentMode @default(STANDARD)
  name             String
  description      String?
  maxScore         Float
  passingScore     Float
  maxAttempts      Int
  timeLimit        Int?
  shuffleQuestions Boolean            @default(false)
  materialTitle    String?
  materialContent  String?
  materialUrl      String?
  materialType     String?
  materialData     Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  course              Course?              @relation(fields: [courseId], references: [id])
  language            LearningLanguage?    @relation(fields: [languageId], references: [id])
  module              Module?              @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lesson              Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attempts            TestAttempt[]
  questions           Question[]
  teacherApplications TeacherApplication[]

  @@index([moduleId])
  @@index([lessonId])
}

enum TestKind {
  COURSE
  PUBLIC_PRACTICE
  TEACHER_ENTRANCE
}

enum TestAssessmentMode {
  STANDARD
  WRITING
  SPEAKING
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  ESSAY
  TRUE_FALSE
  SPEAKING
}

model Question {
  id                     String       @id @default(uuid())
  testId                 String
  type                   QuestionType
  content                String // Nội dung câu hỏi
  audioUrl               String? // URL audio cho câu hỏi listening
  order                  Int
  score                  Float // Điểm cho câu này
  explanation            String? // Giải thích/Lý do đúng
  hint                   String? // Gợi ý
  preparationTimeSeconds Int?
  answerTimeSeconds      Int?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  test    Test     @relation(fields: [testId], references: [id])
  answers Answer[]
}

model Answer {
  id         String  @id @default(uuid())
  questionId String
  content    String // Nội dung đáp án
  isCorrect  Boolean // Đáp án đúng hay sai
  order      Int // Thứ tự đáp án (đặc biệt quan trọng với trắc nghiệm)
  feedback   String? // Phản hồi khi chọn đáp án này

  question Question @relation(fields: [questionId], references: [id])
}

model TestAttempt {
  id          String   @id @default(uuid())
  testId      String
  userId      String
  attemptNo   Int
  score       Float
  maxScore    Float
  answers     Json?
  results     Json?
  startedAt   DateTime
  submittedAt DateTime
  isPassed    Boolean

  test          Test           @relation(fields: [testId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  cheatingLogs  CheatingLog[]
  antiCheatLogs AntiCheatLog[]

  @@unique([testId, userId, attemptNo])
}

model AiAssessment {
  id              String    @id @default(uuid())
  userId          String
  courseId        String?
  type            String
  taskType        String?
  title           String?
  prompt          String?
  submissionText  String?
  audioUrl        String?
  durationSeconds Int?
  score           Float
  maxScore        Float     @default(10)
  bandSystem      String
  bandLevel       String
  bandScore       Float
  criteria        Json
  feedback        Json
  mistakes        Json?
  improvements    Json?
  sampleAnswer    String?
  startedAt       DateTime?
  submittedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  @@index([userId, submittedAt])
  @@index([courseId, submittedAt])
  @@index([type, submittedAt])
}

model PointTransaction {
  id           String   @id @default(uuid())
  userId       String
  courseId     String?
  type         String
  amount       Int
  balanceAfter Int
  sourceKey    String   @unique
  description  String
  metadata     Json?
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model LearningActivity {
  id           String   @id @default(uuid())
  userId       String
  courseId     String?
  activityType String
  sourceKey    String   @unique
  activityDate DateTime
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  @@index([userId, activityDate])
  @@index([activityType, createdAt])
}

model CheatingLog {
  id        String   @id @default(uuid())
  attemptId String
  type      String
  severity  Int
  createdAt DateTime @default(now())

  attempt TestAttempt @relation(fields: [attemptId], references: [id])
}

model LearningLanguage {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]               @relation("UserLearningLanguage")
  courses             Course[]
  tests               Test[]
  teacherApplications TeacherApplication[]
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model TeacherApplication {
  id                        String                   @id @default(uuid())
  userId                    String
  languageId                String
  status                    TeacherApplicationStatus @default(DRAFT)
  attemptNo                 Int
  entranceTestId            String?
  entranceAttemptId         String?
  answerState               Json?
  startedAt                 DateTime?
  submittedAt               DateTime?
  reviewedAt                DateTime?
  reviewedById              String?
  rejectionReason           String?
  violationCount            Int                      @default(0)
  failureReason             String?
  antiCheatAcknowledgedAt   DateTime?
  proctorSessionId          String?
  proctorHeartbeatAt        DateTime?
  proctorHeartbeatSequence  Int                      @default(0)
  questionRevealState       Json?
  currentQuestionInstanceId String?
  sequentialCompletedAt     DateTime?
  entrancePassingScore      Float?
  entranceMaxScore          Float?
  entranceTimeLimit         Int?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  user              User                              @relation("TeacherApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  language          LearningLanguage                  @relation(fields: [languageId], references: [id])
  entranceTest      Test?                             @relation(fields: [entranceTestId], references: [id])
  reviewedBy        User?                             @relation("TeacherApplicationReviewer", fields: [reviewedById], references: [id])
  certificates      TeacherCertificate[]
  logs              TeacherApplicationLog[]
  antiCheatLogs     AntiCheatLog[]
  suspiciousEvents  SuspiciousEvent[]
  questionInstances TeacherEntranceQuestionInstance[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum TeacherQuestionInstanceStatus {
  LOCKED
  REVEALED
  ANSWERING
  FINALIZING
  FINALIZED
  SKIPPED
  EXPIRED
}

enum TeacherSpeakingMediaStatus {
  NONE
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model TeacherEntranceQuestionInstance {
  id                               String                        @id @default(uuid())
  applicationId                    String
  sourceQuestionId                 String
  sequence                         Int
  type                             QuestionType
  content                          String
  audioUrl                         String?
  hint                             String?
  score                            Float
  preparationTimeSeconds           Int?
  answerTimeSeconds                Int?
  answerOptions                    Json?
  scoringData                      Json?
  status                           TeacherQuestionInstanceStatus @default(LOCKED)
  revealedAt                       DateTime?
  answerStartsAt                   DateTime?
  deadlineAt                       DateTime?
  answerState                      String?
  answerRevision                   Int                           @default(0)
  finalAnswer                      String?
  finalizedAt                      DateTime?
  transitionTokenHash              String?
  transitionTokenExpiresAt         DateTime?
  speakingAudioUrl                 String?
  speakingAudioHash                String?
  speakingAudioMime                String?
  speakingAudioBytes               Int?
  speakingMediaStatus              TeacherSpeakingMediaStatus    @default(NONE)
  speakingTranscript               String?
  speakingProcessingTokenHash      String?
  speakingProcessingTokenExpiresAt DateTime?
  speakingProcessingError          String?
  speakingProcessingAttempts       Int                           @default(0)
  contentHash                      String
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, sequence])
  @@index([applicationId, status])
  @@index([applicationId, id])
  @@index([applicationId, speakingMediaStatus])
}

enum TeacherApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  FAILED_CHEATING
}

model TeacherCertificate {
  id            String   @id @default(uuid())
  applicationId String
  fileName      String
  fileUrl       String
  fileType      String
  fileSize      Int
  expiryDate    DateTime
  createdAt     DateTime @default(now())

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model TeacherApplicationLog {
  id            String                   @id @default(uuid())
  applicationId String
  status        TeacherApplicationStatus
  message       String
  actorId       String?
  createdAt     DateTime                 @default(now())

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AntiCheatLog {
  id              String    @id @default(uuid())
  applicationId   String
  testAttemptId   String?
  eventType       String
  detail          String?
  severity        Int       @default(1)
  durationSeconds Int?
  confidence      Float?
  counted         Boolean   @default(false)
  clientTimestamp DateTime?
  serverTimestamp DateTime  @default(now())
  metadata        Json?
  incidentId      String?

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  testAttempt TestAttempt?       @relation(fields: [testAttemptId], references: [id])

  @@unique([applicationId, incidentId])
  @@index([applicationId, serverTimestamp])
  @@index([applicationId, eventType, serverTimestamp])
  @@index([applicationId, counted])
}

model SuspiciousEvent {
  id                   String   @id @default(uuid())
  applicationId        String
  eventType            String
  count                Int      @default(0)
  totalDurationSeconds Int      @default(0)
  severity             Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, eventType])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id        String    @id @default(uuid())
  userId    String?
  to        String
  subject   String
  status    String
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  content   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

model Order {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?
}

model OrderItem {
  id             String @id @default(uuid())
  orderId        String
  courseId       String
  price          Float
  adminRevenue   Int    @default(0)
  teacherRevenue Int    @default(0)
  revenueSplit   String @default("ADMIN_ONLY")

  order         Order                @relation(fields: [orderId], references: [id])
  course        Course               @relation(fields: [courseId], references: [id])
  refundRequest CourseRefundRequest?

  @@unique([orderId, courseId])
}

enum CourseRefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CourseRefundRequest {
  id           String                    @id @default(uuid())
  studentId    String
  courseId     String
  orderItemId  String                    @unique
  amount       Int
  reason       String
  status       CourseRefundRequestStatus @default(PENDING)
  adminNote    String?
  reviewedById String?
  processedAt  DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  refundMethod String                    @default("EXTERNAL_ACCOUNT")

  student    User      @relation("RefundRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderItem  OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("RefundRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([courseId, createdAt])
  @@index([status, createdAt])
}

enum CourseReportCategory {
  INACCURATE_CONTENT
  BROKEN_RESOURCE
  ACCESS_PROBLEM
  INAPPROPRIATE_CONTENT
  QUALITY_MISMATCH
  INSTRUCTOR_PROBLEM
  OTHER
}

enum CourseReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

model CourseReport {
  id                String               @id @default(uuid())
  courseId          String
  reporterId        String
  lessonId          String?
  category          CourseReportCategory
  title             String
  description       String
  truthfulConfirmed Boolean              @default(false)
  status            CourseReportStatus   @default(PENDING)
  response          String?
  respondedById     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reporter    User    @relation("CourseReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  lesson      Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  respondedBy User?   @relation("CourseReportResponder", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([courseId, createdAt])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([lessonId])
}

enum TeacherRevenueWithdrawalStatus {
  PENDING
  APPROVED
  PAID
  COMPLETED
  REJECTED
}

enum TeacherBankAccountVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

model TeacherBankAccount {
  id                 String                               @id @default(uuid())
  teacherId          String                               @unique
  bankName           String
  accountNumber      String
  accountName        String
  branch             String?
  verificationStatus TeacherBankAccountVerificationStatus @default(UNVERIFIED)
  createdAt          DateTime                             @default(now())
  updatedAt          DateTime                             @updatedAt

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherBankAccountChangeOtp {
  id         String    @id @default(uuid())
  teacherId  String
  email      String
  codeHash   String
  payload    Json
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
  @@index([email, createdAt])
}

model TeacherBankAccountChangeLog {
  id                          String   @id @default(uuid())
  teacherId                   String
  previousBankName            String?
  previousAccountNumberMasked String?
  previousAccountName         String?
  previousBranch              String?
  nextBankName                String
  nextAccountNumberMasked     String
  nextAccountName             String
  nextBranch                  String?
  requestIp                   String?
  deviceFingerprint           String?
  createdAt                   DateTime @default(now())

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
}

enum TeacherRevenueWithdrawalComplaintReason {
  NOT_RECEIVED
  WRONG_AMOUNT
  OTHER
}

enum TeacherRevenueWithdrawalComplaintStatus {
  OPEN
  RESOLVED
  REJECTED
}

model TeacherRevenueWithdrawal {
  id                      String                               @id @default(uuid())
  teacherId               String
  amount                  Int
  bankName                String
  accountNumber           String
  accountName             String
  bankBranch              String?
  bankVerificationStatus  TeacherBankAccountVerificationStatus @default(UNVERIFIED)
  status                  TeacherRevenueWithdrawalStatus       @default(PENDING)
  note                    String?
  transferTransactionCode String?
  processedById           String?
  processedAt             DateTime?
  createdAt               DateTime                             @default(now())
  updatedAt               DateTime                             @updatedAt

  teacher     User                               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  processedBy User?                              @relation("RevenueWithdrawalProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  complaint   TeacherRevenueWithdrawalComplaint?

  @@index([teacherId, createdAt])
  @@index([status, createdAt])
}

model TeacherRevenueWithdrawalComplaint {
  id                String                                  @id @default(uuid())
  withdrawalId      String                                  @unique
  teacherId         String
  reason            TeacherRevenueWithdrawalComplaintReason
  reportedAmount    Int?
  message           String
  evidenceImageUrl  String?
  evidenceImageName String?
  status            TeacherRevenueWithdrawalComplaintStatus @default(OPEN)
  adminNote         String?
  resolvedAt        DateTime?
  createdAt         DateTime                                @default(now())
  updatedAt         DateTime                                @updatedAt

  withdrawal TeacherRevenueWithdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  teacher    User                     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
  @@index([status, createdAt])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String    @id @default(uuid())
  orderId           String?   @unique
  userId            String
  courseId          String?
  purpose           String?
  pointAmount       Int?
  provider          String    @default("VNPAY")
  txnRef            String    @unique
  amount            Int
  status            String
  orderInfo         String?
  bankCode          String?
  transactionNo     String?
  responseCode      String?
  transactionStatus String?
  payDate           String?
  rawResponse       Json?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order  Order?  @relation(fields: [orderId], references: [id])
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@index([purpose, createdAt])
  @@index([status, createdAt])
}
